{
  "name": "dsh-drive-manager",
  "version": "0.2.0",
  "description": "多磁盘分工管家：自动识别 C/D/E/F… 固定盘，用绿/黄/红标出可直接清理、需要确认、系统占用的空间，核对系统下载文件夹、浏览器、微信/QQ/Steam 的下载目录，并给出多盘分工与迁移建议。只读，不删除文件。",
  "type": "module",
  "main": "plugin/index.js",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./plugin/index.js",
    "./client": "./plugin/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./plugin/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JKL-3484/-.git"
  },
  "homepage": "https://github.com/JKL-3484/-#readme",
  "bugs": {
    "url": "https://github.com/JKL-3484/-/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "disk",
    "storage",
    "cleanup",
    "windows",
    "multi-drive",
    "c-drive",
    "d-drive",
    "e-drive"
  ],
  "files": [
    "plugin/",
    "README.md",
    "LICENSE"
  ]
}
